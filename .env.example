DATABASE_URL=postgresql://user:pass@host:5432/db
# PGSSL=1                      # set if your Postgres needs SSL

# --- WhatsApp (optional) ---
WA_TOKEN=                      # permanent system-user token
WA_PHONE_NUMBER_ID=            # the bot number's phone number id
WA_APP_SECRET=                 # Meta app secret (verifies webhook signatures)
WA_VERIFY_TOKEN=any-random-string
WA_API_VERSION=v21.0

OWNER_PHONE=9198XXXXXXXX       # WhatsApp ping when a trip ends (country code, no +)

# --- Telegram (optional, the easy one) ---
TG_BOT_TOKEN=                  # from @BotFather
TG_WEBHOOK_SECRET=any-random-string
OWNER_TELEGRAM_CHAT_ID=        # your chat id (send /start to the bot, then GET .../getUpdates and copy message.chat.id)
ADMIN_PASSWORD=change-me       # owner dashboard login
